{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "*": ["./*"]
    }
  },
  "include": ["src", "server.ts", "vite.config.ts"],
  "exclude": [
    "src/legacy/**",
    "src/legacy",
    "src/data/visualQaPresets.ts",
    "src/utils/audio.ts",
    "src/engine/moduleManager.ts",
    "src/data/challenges.ts",
    "src/data/showScenarios.ts",
    "src/utils/broadcastCanvasRenderer.ts",
    "src/utils/broadcastState.ts",
    "src/utils/voiceDirectorEngine.ts",
    "src/utils/opfsStorage.ts",
    "src/utils/audio.ts",
    "src/components/broadcast/**",
    "src/tests/**",
    "src/hooks/useBroadcastRecorder.ts",
    "src/hooks/useGeminiLive.ts",
    "src/hooks/useRouter.ts",
    "src/components/DirectorStage.tsx",
    "src/components/BroadcastStage.tsx",
    "src/components/Controls.tsx",
    "src/components/Scoreboard.tsx",
    "src/components/TimerDisplay.tsx",
    "src/components/CameraPreview.tsx",
    "src/components/DevSmokeTestBar.tsx",
    "src/components/EventLogList.tsx",
    "src/components/ManualOverrideModal.tsx",
    "src/components/MysteryRevealModal.tsx",
    "src/components/ReviewModal.tsx",
    "src/components/RecordingPanel.tsx",
    "src/components/BroadcastAiBadge.tsx",
    "src/components/player/PlayerGameControls.tsx",
    "src/components/visual/CinematicVisualEngine.tsx",
    "src/components/director/VoiceStudioModal.tsx",
    "src/components/director/ShowEngineControlCenter.tsx",
    "src/components/director/DirectorLiveControlRoom.tsx",
    "src/components/director/BroadcastQaView.tsx",
    "src/components/director/LongPressExplainerModal.tsx",
    "src/components/director/OverlayStudioSection.tsx",
    "src/components/director/ProductionLogsModal.tsx",
    "src/components/director/ScenarioSelectorModal.tsx",
    "src/components/director/SmartModuleConfigModal.tsx",
    "src/components/director/VisualQaSection.tsx",
    "src/components/director/VoiceSettingsModal.tsx"
  ]
}
